	Adjust:
		'''
		Hold down the mouse
		and drag outside the panel to resize
		'''
	Move: Hold down the mouse to drag the panel
	Flow: Flow Layout
	Strip: Strip Layout
	Search: Switch to search panel
	OnlyCanBuy: View only items available for purchase
	Find: Requires {0} in the world
	Return: Switch to shop panel
}

